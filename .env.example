# GoldenHour — example environment configuration
# Copy this file to `.env` and fill in values for local development.
# This file is tracked; never commit real secrets.
# `.env` itself is gitignored.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Frontend (used at build time) ---
# Public origin where the backend is reachable from the user's browser.
PUBLIC_BACKEND_ORIGIN=http://localhost:3000

# --- Knowledge Base ---
# Optional override; defaults to the bundled /knowledge-base directory.
KNOWLEDGE_BASE_DIR=

# --- AI provider (NOT configured in Ticket 01) ---
# A future ticket will wire OpenAI or another provider behind a feature flag
# keyed on the knowledge base. For now, leave these as placeholders.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=replace_me

# --- Session / security (placeholders) ---
SESSION_SECRET=replace_me_with_a_long_random_string